<?xml version="1.0" encoding="utf-8"?>

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Blue-tinted pressed surface -->
    <solid
        android:color="?attr/keyPressedBackgroundColor" />

    <!-- Accent edge when pressed -->
    <stroke
        android:width="1dp"
        android:color="#3A7BBD" />

    <corners
        android:radius="@dimen/button_corner_radius_lxx" />

</shape>