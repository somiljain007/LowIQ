<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- =========================================================
         iQOO / SmartIME Dark Gaming Theme
         ========================================================= -->

    <style name="KeyboardTheme.LXX_Dark">

        <item name="inputViewStyle">@style/InputView</item>

        <item name="keyboardStyle">@style/Keyboard.LXX_Dark</item>

        <item name="keyboardViewStyle">@style/KeyboardView.LXX_Dark</item>

        <item name="mainKeyboardViewStyle">@style/MainKeyboardView.LXX_Dark</item>

        <item name="moreKeysKeyboardStyle">@style/MoreKeysKeyboard.LXX_Dark</item>

        <item name="moreKeysKeyboardViewStyle">@style/MoreKeysKeyboardView.LXX_Dark</item>

        <item name="functionalTextColor">
            @color/key_text_color_lxx_dark
        </item>

        <item name="popupPanelBackgroundColor">
            @color/background_secondary_lxx_dark
        </item>

        <item name="keyPressedBackgroundColor">
            @color/key_background_pressed_lxx_dark
        </item>

        <item name="keyNormalBackgroundColor">
            @color/key_background_normal_lxx_dark
        </item>

    </style>


    <!-- Keyboard -->

    <style
        name="Keyboard.LXX_Dark"
        parent="Keyboard">
    </style>


    <!-- Main keyboard view -->

    <style
        name="KeyboardView.LXX_Dark"
        parent="KeyboardView">

        <!-- Main keyboard background -->
        <item name="android:background">
            @color/background_lxx_dark
        </item>

        <!-- Individual keys -->
        <item name="keyBackground">
            @drawable/btn_keyboard_key
        </item>

        <item name="functionalKeyBackground">
            @drawable/btn_keyboard_key
        </item>

        <item name="spacebarBackground">
            @drawable/btn_keyboard_spacebar
        </item>

        <!-- Key typography -->

        <item name="keyTextColor">
            @color/key_text_color_lxx_dark
        </item>

        <item name="keyTextInactivatedColor">
            @color/key_functional_text_color_lxx_dark
        </item>

        <item name="keyHintLetterColor">
            @color/key_hint_letter_color_lxx_dark
        </item>

        <item name="keyHintLabelColor">
            @color/key_text_inactive_color_lxx_dark
        </item>

        <item name="keyShiftedLetterHintInactivatedColor">
            @color/key_text_inactive_color_lxx_dark
        </item>

        <item name="keyShiftedLetterHintActivatedColor">
            @color/key_text_color_lxx_dark
        </item>

        <item name="keyPreviewTextColor">
            @color/key_text_color_lxx_dark
        </item>

    </style>


    <!-- Main keyboard -->

    <style
        name="MainKeyboardView.LXX_Dark"
        parent="KeyboardView.LXX_Dark">

        <item name="keyPreviewBackground">
            @drawable/keyboard_key_feedback_background
        </item>

        <item name="keyPreviewHeight">
            @dimen/config_key_preview_height_lxx
        </item>

        <item name="keyPreviewWidth">
            @dimen/config_key_preview_width_lxx
        </item>

        <item name="keyPreviewOffset">
            @dimen/config_key_preview_offset_lxx
        </item>

        <item name="keyPreviewDismissAnimator">
            @anim/key_preview_dismiss_lxx
        </item>

        <item name="languageOnSpacebarTextColor">
            @color/key_text_inactive_color_lxx_dark
        </item>

    </style>


    <!-- Popup / long-press keyboard -->

    <style
        name="MoreKeysKeyboard.LXX_Dark"
        parent="Keyboard.LXX_Dark">

        <item name="keyboardTopPadding">0%p</item>

        <item name="keyboardBottomPadding">0%p</item>

        <item name="horizontalGap">0%p</item>

    </style>


    <style
        name="MoreKeysKeyboardView.LXX_Dark"
        parent="KeyboardView.LXX_Dark">

        <item name="android:background">
            @drawable/keyboard_popup_panel_background
        </item>

        <item name="keyBackground">
            @drawable/btn_keyboard_key_popup
        </item>

        <item name="keyTypeface">normal</item>

        <item name="verticalCorrection">
            @dimen/config_more_keys_keyboard_vertical_correction
        </item>

    </style>

</resources>